---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BlogLayout title="Engineering Blog: Backend, AWS & Identity" description="Practical notes on backend systems, AWS, and identity infrastructure. Implementation details, tradeoffs, and the parts the docs skip.">
  <header class="hero blog-hero">
    <p class="hero-eyebrow"><span class="accent" aria-hidden="true">//</span> FIELD NOTES</p>
    <h1 class="blog-title">From the workbench.</h1>
    <p class="hero-intro">Notes from building backend systems and identity infrastructure. Implementation details, tradeoffs, and the parts the docs skip.</p>
  </header>
  <section class="sec writing-archive" aria-label="All articles">
    <div class="archive-heading"><h2 class="section-index">ALL ARTICLES <span class="term-mut">/ {posts.length}</span></h2><a href="/blog/rss.xml" class="quiet-link">RSS feed <span aria-hidden="true">&nearr;</span></a></div>
    <div class="journal-list">
      {posts.map((post) => (
        <article class="journal-entry">
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
          <div><h3><a href={`/blog/${post.id}/`}>{post.data.title}<span aria-hidden="true">&nearr;</span></a></h3><p>{post.data.description}</p></div>
          <span class="journal-tags">{post.data.tags.slice(0, 2).join(' / ')}</span>
        </article>
      ))}
    </div>
  </section>
</BlogLayout>
