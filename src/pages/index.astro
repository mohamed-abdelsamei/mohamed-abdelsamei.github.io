---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Mohamed Abdelsamei — Backend Engineer, AWS & Identity Infrastructure"
  description="Mohamed Abdelsamei — backend engineer building identity infrastructure for humans and AI agents on AWS. Explore projects and practical writing on backend systems."
  ogType="profile"
  navAccent="contact"
>
  <header class="home-hero" id="top">
    <div class="hero-eyebrow"><span class="accent" aria-hidden="true">//</span> BACKEND ENGINEER &amp; BUILDER</div>
    <h1>Mohamed<br />Abdelsamei<span class="name-period">.</span></h1>
    <div class="intro-grid">
      <p class="intro-statement">I build the systems<br />behind trust.</p>
      <div class="intro-copy">
        <p>Ten years building backend systems. Today, my focus is identity for humans and AI agents, reliable infrastructure on AWS, and tools that make engineering a little easier.</p>
        <div class="hero-actions">
          <a href="#projects" class="text-link">Explore my work <span aria-hidden="true">&darr;</span></a>
          <a href="#contact" class="quiet-link">Get in touch <span aria-hidden="true">&nearr;</span></a>
        </div>
      </div>
    </div>
    <div class="hero-footnote"><span>Identity &middot; Infrastructure &middot; Developer tools</span><span aria-hidden="true">SCROLL TO EXPLORE &darr;</span></div>
  </header>

  <section class="portfolio-section" id="projects" aria-labelledby="projects-title">
    <span id="open-source" class="legacy-anchor" aria-hidden="true"></span>
    <div class="section-heading">
      <p class="section-index"><span aria-hidden="true">01 /</span> PROJECTS</p>
      <div><h2 id="projects-title">Things I&rsquo;ve built.</h2><p>Useful tools, from the desktop to the infrastructure underneath it.</p></div>
    </div>

    <article class="project-feature project-feature--tracing">
      <div class="project-copy">
        <div class="project-kicker"><span>01</span><span>OPEN-SOURCE LIBRARY</span></div>
        <h3><a href="/projects/aws-xray-sdk/">aws_xray_sdk<span class="accent" aria-hidden="true">&nearr;</span></a></h3>
        <p class="project-lede">Make the invisible<br />observable.</p>
        <p class="project-description">Distributed tracing for Dart on AWS. I built this package to trace HTTP and AWS SDK calls, propagate trace context, and put Lambda invocations into a trace tree you can actually follow.</p>
        <p class="project-tech">Dart &middot; AWS X-Ray &middot; Lambda &middot; MIT</p>
        <p class="project-status project-status--published"><span aria-hidden="true"></span> Published on pub.dev &middot; verified publisher</p>
        <div class="project-links">
          <a href="/projects/aws-xray-sdk/" class="text-link">Project details &rarr;</a>
          <a href="https://pub.dev/packages/aws_xray_sdk" class="text-link" target="_blank" rel="noopener noreferrer">Explore the package <span aria-hidden="true">&nearr;</span></a>
          <a href="https://github.com/mohamed-abdelsamei/aws-xray-sdk-dart" class="quiet-link" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">&nearr;</span></a>
        </div>
      </div>
      <figure class="project-figure tracing-figure">
        <div class="trace-preview">
          <div class="preview-toolbar"><span aria-hidden="true">&gt;_</span><span>trace / lambda.invocation</span></div>
          <img src="/posters/xray-tracing-dart-on-lambda.png" width="1440" height="480" alt="Illustrative trace waterfall showing a Lambda handler, validation, an external HTTP call, and a DynamoDB write." loading="lazy" />
          <div class="install-line"><span aria-hidden="true">$</span><code>dart pub add aws_xray_sdk</code></div>
        </div>
        <figcaption><span>AWS X-RAY / DART</span><a href="/blog/xray-tracing-dart-on-lambda/">Read the implementation guide <span aria-hidden="true">&rarr;</span></a></figcaption>
      </figure>
    </article>
  </section>

  <section class="portfolio-section" id="writing" aria-labelledby="writing-title">
    <div class="section-heading">
      <p class="section-index"><span aria-hidden="true">02 /</span> FIELD NOTES</p>
      <div><h2 id="writing-title">From the workbench.</h2><p>Implementation details, tradeoffs, and the parts the docs skip.</p></div>
      <a href="/blog/" class="quiet-link section-more">All writing <span aria-hidden="true">&nearr;</span></a>
    </div>
    <div class="journal-list">
      {posts.map((post) => (
        <article class="journal-entry">
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
          <div><h3><a href={`/blog/${post.id}/`}>{post.data.title}<span aria-hidden="true">&nearr;</span></a></h3><p>{post.data.description}</p></div>
          <span class="journal-tags">{post.data.tags.slice(0, 2).join(' / ')}</span>
        </article>
      ))}
    </div>
    <p class="rss-note">Prefer a feed? <a href="/blog/rss.xml">Follow via RSS <span aria-hidden="true">&nearr;</span></a></p>
  </section>

  <section class="portfolio-section" id="work" aria-labelledby="about-title">
    <div class="section-heading">
      <p class="section-index"><span aria-hidden="true">03 /</span> ABOUT</p>
      <div><h2 id="about-title">Under the hood.</h2><p>Engineering that earns trust through the details.</p></div>
    </div>
    <div class="about-grid">
      <div class="about-intro"><p>I care about what happens after a system ships.</p><p>The identities it protects. The failures it handles. The engineers who have to maintain it.</p><a href="https://www.linkedin.com/in/mohamed-abdelsamei/" class="text-link" target="_blank" rel="me noopener noreferrer">More about my experience <span aria-hidden="true">&nearr;</span></a></div>
      <div class="expertise-list">
        <article><span class="expertise-number" aria-hidden="true">01</span><div><h3>Identity &amp; delegation</h3><p>Verifiable credentials, OID4VP, OID4VCI, and the delegation models that let agents act on someone&rsquo;s behalf.</p></div></article>
        <article><span class="expertise-number" aria-hidden="true">02</span><div><h3>Infrastructure &amp; reliability</h3><p>Cloud-native services on AWS, distributed systems, observability, and safe execution environments for agents.</p></div></article>
        <article><span class="expertise-number" aria-hidden="true">03</span><div><h3>Technical leadership</h3><p>System design across product, infrastructure, and security. Mentoring engineers to own architecture as well as implementation.</p></div></article>
      </div>
    </div>
    <div class="toolbox" id="stack"><span class="section-index">TOOLS OF THE TRADE</span><p>TypeScript / Node.js / Dart / AWS / CDK / DynamoDB / Docker / OAuth 2.0 / OIDC</p></div>
  </section>

  <section class="portfolio-section contact-section" id="contact" aria-labelledby="contact-title">
    <p class="section-index"><span aria-hidden="true">04 /</span> CONNECT</p>
    <div class="contact-grid"><h2 id="contact-title">Let&rsquo;s compare<br />notes<span class="accent">.</span></h2><div><p>Identity, backend systems, or something you&rsquo;re building in the open. Always happy to exchange ideas.</p><a href="mailto:mohamed@mabdelsamei.com?subject=Let's%20talk" class="contact-email">mohamed@mabdelsamei.com <span aria-hidden="true">&nearr;</span></a><div class="contact-socials"><a href="https://github.com/mohamed-abdelsamei" target="_blank" rel="me noopener noreferrer">GitHub <span aria-hidden="true">&nearr;</span></a><a href="https://www.linkedin.com/in/mohamed-abdelsamei/" target="_blank" rel="me noopener noreferrer">LinkedIn <span aria-hidden="true">&nearr;</span></a></div></div></div>
  </section>
</Layout>
