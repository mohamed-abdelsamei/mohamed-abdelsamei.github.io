---
// Self-hosted JetBrains Mono (bundled from @fontsource, served from our origin):
// loading it from fonts.googleapis.com sent every visitor's IP to Google, which
// German courts have held to need consent (LG München I, 3 O 17493/20). Keep it local.
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '../styles/global.css';
import { PERSON_DESCRIPTION } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  ogType?: 'profile' | 'website' | 'article';
  image?: string;
  imageAlt?: string;
  structuredData?: Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Site-relative path of this page's markdown twin, for agents (rel=alternate). */
  markdownPath?: string;
  tags?: string[];
  navAccent?: 'contact' | 'writing' | 'projects';
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  image = '/og-image.png',
  imageAlt = title,
  structuredData = [],
  publishedTime,
  modifiedTime,
  markdownPath,
  tags = [],
  navAccent = 'contact',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Same entity as the Person JSON-LD emitted on every page — keep in sync.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://mabdelsamei.com/#person',
  name: 'Mohamed Abdelsamei',
  url: 'https://mabdelsamei.com/',
  image: 'https://mabdelsamei.com/og-image.png',
  jobTitle: 'Senior Backend Engineer',
  description: PERSON_DESCRIPTION,
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  knowsAbout: [
    'Digital Identity', 'Verifiable Credentials', 'OID4VP', 'OID4VCI', 'Self-Sovereign Identity',
    'AI Agent Identity', 'Agent Sandboxing', 'TypeScript', 'Node.js', 'Dart', 'Rust',
    'AWS', 'AWS Lambda', 'Serverless', 'DynamoDB', 'Terraform',
  ],
  worksFor: { '@type': 'Organization', name: 'Affinidi' },
  sameAs: [
    'https://github.com/mohamed-abdelsamei',
    'https://www.linkedin.com/in/mohamed-abdelsamei/',
  ],
};

// Google's site name (the line above the URL in results) is read from the homepage's
// copy of this entity only, and applies domain-wide. The other pages carry an identical
// copy so their `isPartOf` / `publisher` @id references resolve on the same page.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://mabdelsamei.com/#website',
  name: 'Mohamed Abdelsamei',
  alternateName: 'mabdelsamei',
  url: 'https://mabdelsamei.com/',
  publisher: { '@id': 'https://mabdelsamei.com/#person' },
};

const blogPostingSchema =
  ogType === 'article' && publishedTime
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        '@id': `${canonicalURL}#article`,
        headline: title.replace(/ — Mohamed Abdelsamei$/, ''),
        description,
        datePublished: publishedTime.toISOString(),
        dateModified: (modifiedTime ?? publishedTime).toISOString(),
        url: canonicalURL.toString(),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
        image: ogImage.toString(),
        inLanguage: 'en',
        author: { '@type': 'Person', '@id': 'https://mabdelsamei.com/#person', name: 'Mohamed Abdelsamei', url: 'https://mabdelsamei.com/' },
        publisher: { '@id': 'https://mabdelsamei.com/#person' },
        isPartOf: { '@id': 'https://mabdelsamei.com/#website' },
        keywords: tags.join(', '),
      }
    : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonicalURL} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title="Markdown version" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Mohamed Abdelsamei" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime.toISOString()} />
        <meta property="article:modified_time" content={(modifiedTime ?? publishedTime).toISOString()} />
        <meta property="article:author" content="https://mabdelsamei.com/" />
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content="Mohamed" />
        <meta property="profile:last_name" content="Abdelsamei" />
        <meta property="profile:username" content="mohamed-abdelsamei" />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {blogPostingSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    )}

    {structuredData.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon_32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon_180.png" />
    <meta name="theme-color" content="#0b0d0c" />
    <link rel="alternate" type="application/rss+xml" title="Mohamed Abdelsamei" href="/blog/rss.xml" />
    <script is:inline>
      // Apply saved theme before first paint to avoid a flash
      (function () {
        try {
          if (localStorage.getItem('ma-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
        } catch (e) { /* storage unavailable — stay dark */ }
      })();
    </script>
    {/* Cookieless pageview analytics. Double-gated: PROD keeps it out of `astro dev`,
        data-domains keeps a local `dist/` preview from polluting real stats. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="93a36481-0028-4133-9936-7b54c56aefc7"
        data-domains="mabdelsamei.com"
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Site">
      <a href="/#top" class="logo" aria-label="Mohamed Abdelsamei home">ma<span class="logo-block" aria-hidden="true"></span></a>
      <div class="nav-links">
        <a href="/#projects" class={navAccent === 'projects' ? 'accent' : undefined}>projects</a>
        <a href="/blog/" class={navAccent === 'writing' ? 'accent' : undefined}>writing</a>
        <a href="/#work">about</a>
        <a href="/#contact" class={navAccent === 'contact' ? 'accent' : undefined}>contact</a>
        <button type="button" class="theme-btn" id="theme-btn" aria-label="Switch to light theme">
          <span class="theme-dot theme-dot--active" id="theme-dot-dark" aria-hidden="true"></span>
          <span class="theme-dot" id="theme-dot-light" aria-hidden="true"></span>
        </button>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer>
      <span>&copy; 2026 Mohamed Abdelsamei &middot; cookieless analytics, no personal data retained</span>
      <span class="logo logo--sm">ma<span class="logo-block" aria-hidden="true"></span></span>
    </footer>

    <script is:inline>
      // Theme toggle, persisted across visits
      const btn = document.getElementById('theme-btn');
      const root = document.documentElement;
      const dotDark = document.getElementById('theme-dot-dark');
      const dotLight = document.getElementById('theme-dot-light');
      const sync = () => {
        const isLight = root.dataset.theme === 'light';
        dotDark.classList.toggle('theme-dot--active', !isLight);
        dotLight.classList.toggle('theme-dot--active', isLight);
        btn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
        // Keep mobile browser chrome matched to the page background
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isLight ? '#fafaf7' : '#0b0d0c');
      };
      btn.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        if (next === 'light') { root.dataset.theme = 'light'; }
        else { delete root.dataset.theme; }
        try { localStorage.setItem('ma-theme', next); } catch (e) { /* ignore */ }
        sync();
      });
      sync();

      // Track wrapped navigation and zoom instead of assuming a fixed height.
      const nav = document.querySelector('.nav');
      if (nav && typeof ResizeObserver !== 'undefined') {
        const updateAnchorOffset = () => {
          root.style.setProperty('--anchor-offset', `${Math.ceil(nav.getBoundingClientRect().height) + 16}px`);
        };
        updateAnchorOffset();
        new ResizeObserver(updateAnchorOffset).observe(nav);
      }
    </script>

    <slot name="scripts" />
  </body>
</html>
