---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogType?: 'profile' | 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  tags?: string[];
  navAccent?: 'contact' | 'writing';
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  image = '/og-image.png',
  publishedTime,
  tags = [],
  navAccent = 'contact',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Same entity as the Person JSON-LD emitted on every page — keep in sync.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mohamed Abdelsamei',
  url: 'https://mabdelsamei.com/',
  image: 'https://mabdelsamei.com/og-image.png',
  jobTitle: 'Senior Backend Engineer',
  description:
    'Backend and identity infrastructure engineer building on AWS. 10 years building privacy-preserving systems with Verifiable Credentials, OID4VP, and OID4VCI — now focused on identity for humans and AI agents, and safe agent execution environments. Publishes technical writing on identity and backend systems.',
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  knowsAbout: [
    'Digital Identity', 'Verifiable Credentials', 'OID4VP', 'OID4VCI', 'Self-Sovereign Identity',
    'AI Agent Identity', 'Agent Sandboxing', 'TypeScript', 'Node.js', 'Dart', 'Rust',
    'AWS', 'AWS Lambda', 'Serverless', 'DynamoDB', 'Terraform',
  ],
  worksFor: { '@type': 'Organization', name: 'Affinidi' },
  sameAs: [
    'https://github.com/mohamed-abdelsamei',
    'https://www.linkedin.com/in/mohamed-abdelsamei/',
  ],
};

const blogPostingSchema =
  ogType === 'article' && publishedTime
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: publishedTime.toISOString(),
        url: canonicalURL.toString(),
        image: ogImage.toString(),
        author: { '@type': 'Person', name: 'Mohamed Abdelsamei', url: 'https://mabdelsamei.com/' },
        keywords: tags.join(', '),
      }
    : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content="Mohamed" />
        <meta property="profile:last_name" content="Abdelsamei" />
        <meta property="profile:username" content="mohamed-abdelsamei" />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {blogPostingSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon_32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon_180.png" />
    <meta name="theme-color" content="#0b0d0c" />
    <link rel="alternate" type="application/rss+xml" title="Mohamed Abdelsamei" href="/blog/rss.xml" />
    <script is:inline>
      // Apply saved theme before first paint to avoid a flash
      (function () {
        try {
          if (localStorage.getItem('ma-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
        } catch (e) { /* storage unavailable — stay dark */ }
      })();
    </script>
    {/* Cookieless pageview analytics. Double-gated: PROD keeps it out of `astro dev`,
        data-domains keeps a local `dist/` preview from polluting real stats. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="93a36481-0028-4133-9936-7b54c56aefc7"
        data-domains="mabdelsamei.com"
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Site">
      <a href="/#top" class="logo">ma<span class="logo-block" aria-hidden="true"></span></a>
      <div class="nav-links">
        <a href="/#work">work</a>
        <a href="/#open-source">open_source</a>
        <a href="/blog/" class={navAccent === 'writing' ? 'accent' : undefined}>writing</a>
        <a href="/#stack">stack</a>
        <a href="/#contact" class={navAccent === 'contact' ? 'accent' : undefined}>contact</a>
        <button type="button" class="theme-btn" id="theme-btn" aria-label="Switch to light theme">
          <span class="theme-dot theme-dot--active" id="theme-dot-dark" aria-hidden="true"></span>
          <span class="theme-dot" id="theme-dot-light" aria-hidden="true"></span>
        </button>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer>
      <span>&copy; 2026 Mohamed Abdelsamei &middot; utc+1</span>
      <span class="logo logo--sm">ma<span class="logo-block" aria-hidden="true"></span></span>
    </footer>

    <script is:inline>
      // Theme toggle, persisted across visits
      const btn = document.getElementById('theme-btn');
      const root = document.documentElement;
      const dotDark = document.getElementById('theme-dot-dark');
      const dotLight = document.getElementById('theme-dot-light');
      const sync = () => {
        const isLight = root.dataset.theme === 'light';
        dotDark.classList.toggle('theme-dot--active', !isLight);
        dotLight.classList.toggle('theme-dot--active', isLight);
        btn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
      };
      btn.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        if (next === 'light') { root.dataset.theme = 'light'; }
        else { delete root.dataset.theme; }
        try { localStorage.setItem('ma-theme', next); } catch (e) { /* ignore */ }
        sync();
      });
      sync();
    </script>

    <slot name="scripts" />
  </body>
</html>
